{
  "name": "address-book-xp-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "address-book-xp-production",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "168251675",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
